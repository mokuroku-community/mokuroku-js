{
  "name": "@mokurokujs/bullmq-adapter",
  "version": "0.0.1",
  "description": "BullMQ adapter package for mokuroku-js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "pnpm exec -- biome lint .",
    "format:fix": "pnpm exec -- biome check . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@mokurokujs/core": "workspace:*",
    "bullmq": "^5.66.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@testcontainers/redis": "^11.10.0",
    "testcontainers": "^11.10.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.15"
  }
}
