{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "typecheck": {
            "dependsOn": [
                "^typecheck"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "format:fix": {
            "dependsOn": [
                "^format:fix"
            ]
        },
        "test": {
            "dependsOn": [
                "^test"
            ],
            "outputs": [],
            "cache": false,
            "env": [
                "REQUIRE_REDIS_TESTS",
                "SKIP_REDIS_TESTS",
                "TEST_REDIS_DISABLED",
                "VITEST_REDIS_IMAGE",
                "DOCKER_*",
                "TESTCONTAINERS_*"
            ]
        },
        "clean": {
            "cache": false
        }
    }
}
